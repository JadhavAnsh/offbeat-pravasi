# Public values embedded in the Expo app bundle. Configure the same names under
# expo.dev > Project settings > Environment variables for cloud builds/updates.
# EXPO_PUBLIC values are readable by app and web users; never place a true
# server-side secret here.
EXPO_PUBLIC_API_URL=https://api.offbeatpravasi.com/api/v1
EXPO_PUBLIC_DEMO_DATA=false
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_API_KEY_HEADER=x-api-key
EXPO_PUBLIC_APP_ENV=development
